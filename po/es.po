#: data/tech.digiroad.ImageFlow.metainfo.xml.in:8
msgid "Video to animated images"
msgstr "Convierte vídeos en imágenes animadas"

#: data/tech.digiroad.ImageFlow.metainfo.xml.in:10
msgid "Golodnikov Sergey"
msgstr "Golodnikov Sergey"

#: data/tech.digiroad.ImageFlow.metainfo.xml.in:14
msgid ""
"This application converts videos into animated GIF, WebP, and AVIF images "
"using the FFmpeg library. You can configure key parameters, including output "
"size, frame rate, filters (such as interpolation and dithering), palette-"
"generation method, and maximum number of colors."
msgstr ""
"Esta aplicación convierte vídeos en imágenes animadas GIF, WebP y AVIF "
"mediante la biblioteca FFmpeg. Puedes configurar los parámetros principales, "
"como el tamaño de salida, la velocidad de fotogramas, los filtros (por "
"ejemplo, la interpolación y el difuminado), el método de generación de la "
"paleta y el número máximo de colores."

